# Optional: the default database is data/zhian.db (SQLite).
# For PostgreSQL install psycopg[binary], then set this environment variable.
# ZHIAN_DATABASE_URL=postgresql+psycopg://username:password@localhost/zhian
# Optional; the default study-day timezone is Asia/Shanghai (UTC+8).
# ZHIAN_TIMEZONE=Asia/Shanghai

# Local startup reads environment variables, not this file.
# Account protection is optional on loopback until the first account is created.
# Require authentication from the first request when deploying remotely.
# ZHIAN_AUTH_REQUIRED=true
# Keep registration closed unless you want additional users to sign up.
# ZHIAN_ALLOW_REGISTRATION=false
# For HTTPS deployments; leave false for http://127.0.0.1 local use.
# ZHIAN_SECURE_COOKIE=true
# ZHIAN_ALLOWED_HOSTS=study.example.com,127.0.0.1
# ZHIAN_ALLOWED_ORIGINS=https://study.example.com
# Set a random secret to initialize the first account through a remote browser.
# ZHIAN_BOOTSTRAP_TOKEN=
# Default: backups beside the SQLite database, or data/backups for PostgreSQL.
# ZHIAN_BACKUP_DIR=E:/private/zhian-backups

# Optional WeChat sign-in. Both values stay on the backend.
# Use the same public AppID as miniapp/src/manifest.json -> mp-weixin.appid.
# ZHIAN_WECHAT_APPID=
# ZHIAN_WECHAT_SECRET=
