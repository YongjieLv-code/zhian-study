# Domain with DNS pointing to your server. No scheme or trailing slash.
ZHIAN_DOMAIN=study.example.com
# Required: generate a random secret before starting Compose.
ZHIAN_BOOTSTRAP_TOKEN=
ZHIAN_ALLOW_REGISTRATION=false
ZHIAN_TIMEZONE=Asia/Shanghai
# Optional; configure both to enable WeChat login. Keep AppSecret server-side.
ZHIAN_WECHAT_APPID=
ZHIAN_WECHAT_SECRET=
