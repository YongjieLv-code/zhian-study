# Mini program requests use this origin; do not include /api or a trailing slash.
# For a real phone and release builds, use your deployed HTTPS domain.
VITE_API_BASE_URL=http://127.0.0.1:8765
# H5 development uses a same-origin proxy instead.
ZHIAN_DEV_API_TARGET=http://127.0.0.1:8765
# Configure the public WeChat AppID in src/manifest.json -> mp-weixin.appid.
# Never put AppSecret, bootstrap secrets, or session keys in VITE_* variables.
